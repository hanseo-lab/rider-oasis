# Backend Environment Variables (Railway)
# These should be set in Railway dashboard, not in code

# Database (Supabase PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-supabase-host.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=your-username
SPRING_DATASOURCE_PASSWORD=your-password

# Security (IMPORTANT: Generate a strong secret key!)
JWT_SECRET=your-very-long-secret-key-at-least-64-characters-for-hs512

# CORS (Add your Vercel domains)
CORS_ALLOWED_ORIGINS=https://rider-oasis.vercel.app,https://rider-oasis-project.vercel.app,http://localhost:5173

# TMAP API Key (Optional - for real road routing)
TMAP_API_KEY=your-tmap-api-key

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
